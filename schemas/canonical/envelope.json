{
  "$defs": {
    "CreditNotePayload": {
      "description": "Stub schema for credit notes.",
      "properties": {
        "credit_note_number": {
          "$ref": "#/$defs/Field_str_"
        },
        "document_date": {
          "$ref": "#/$defs/Field_DateValue_"
        },
        "original_invoice_number": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "total_amount": {
          "$ref": "#/$defs/Field_Money_"
        }
      },
      "required": [
        "credit_note_number",
        "document_date",
        "total_amount"
      ],
      "title": "CreditNotePayload",
      "type": "object"
    },
    "DateValue": {
      "description": "Date representation retaining raw text and ambiguity status per ADR-010 \u00a74.",
      "properties": {
        "ambiguous": {
          "default": false,
          "description": "True if format is ambiguous (e.g. 04/05/2026 where DD/MM vs MM/DD is unresolved).",
          "title": "Ambiguous",
          "type": "boolean"
        },
        "raw": {
          "description": "Raw date string from source document.",
          "title": "Raw",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized ISO 8601 calendar date (YYYY-MM-DD), or None if unparseable.",
          "title": "Value"
        }
      },
      "required": [
        "raw"
      ],
      "title": "DateValue",
      "type": "object"
    },
    "DeliveryChallanPayload": {
      "description": "Stub schema for delivery challans.",
      "properties": {
        "challan_date": {
          "$ref": "#/$defs/Field_DateValue_"
        },
        "challan_number": {
          "$ref": "#/$defs/Field_str_"
        },
        "consignee_name": {
          "$ref": "#/$defs/Field_str_"
        },
        "consignor_name": {
          "$ref": "#/$defs/Field_str_"
        },
        "vehicle_number": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "challan_number",
        "challan_date",
        "consignor_name",
        "consignee_name"
      ],
      "title": "DeliveryChallanPayload",
      "type": "object"
    },
    "DocumentType": {
      "description": "Closed enumeration of document types per ADR-010 \u00a72.",
      "enum": [
        "supplier_invoice",
        "credit_note",
        "purchase_order",
        "delivery_challan",
        "electricity_bill",
        "unknown"
      ],
      "title": "DocumentType",
      "type": "string"
    },
    "ElectricityBillPayload": {
      "description": "Stub schema for electricity bills.",
      "properties": {
        "amount_due": {
          "$ref": "#/$defs/Field_Money_"
        },
        "bill_date": {
          "$ref": "#/$defs/Field_DateValue_"
        },
        "bill_number": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "consumer_account_number": {
          "$ref": "#/$defs/Field_str_"
        },
        "due_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_DateValue_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "utility_provider": {
          "$ref": "#/$defs/Field_str_"
        }
      },
      "required": [
        "utility_provider",
        "consumer_account_number",
        "bill_date",
        "amount_due"
      ],
      "title": "ElectricityBillPayload",
      "type": "object"
    },
    "Evidence": {
      "description": "Verifiable evidence record resolving to source text blocks.",
      "properties": {
        "bbox": {
          "description": "Bounding box [ymin, xmin, ymax, xmax] in original_page_normalized coordinates [0.0, 1.0].",
          "items": {
            "type": "number"
          },
          "title": "Bbox",
          "type": "array"
        },
        "block_ids": {
          "description": "List of persisted OCR or embedded text block IDs supporting this field.",
          "items": {
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        },
        "confidence_calibrated": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nullable calibrated probability; remains null until ADR-014 criteria are met.",
          "title": "Confidence Calibrated"
        },
        "confidence_raw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nullable raw model self-reported score (never used as probability).",
          "title": "Confidence Raw"
        },
        "coordinate_space": {
          "const": "original_page_normalized",
          "default": "original_page_normalized",
          "description": "Coordinate space fixed to original_page_normalized.",
          "title": "Coordinate Space",
          "type": "string"
        },
        "evidence_id": {
          "description": "Unique identifier for this evidence record.",
          "title": "Evidence Id",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/EvidenceMethod",
          "description": "Processing method (embedded, ocr_llm, rules, derived, human)."
        },
        "model_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to pinned model_runs row if generated by an LLM run.",
          "title": "Model Run Id"
        },
        "page": {
          "description": "Source page number (1-indexed).",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "source_engine": {
          "description": "Extraction or OCR engine identifier (e.g. 'tesseract', 'pypdf').",
          "title": "Source Engine",
          "type": "string"
        },
        "support_status": {
          "$ref": "#/$defs/SupportStatus",
          "default": "supported",
          "description": "Support disposition after value-support verification."
        },
        "text_source": {
          "$ref": "#/$defs/TextSource",
          "description": "Underlying source mechanism (embedded or ocr)."
        },
        "text_span": {
          "description": "Exact cited text span from the source document.",
          "title": "Text Span",
          "type": "string"
        }
      },
      "required": [
        "page",
        "bbox",
        "text_span",
        "source_engine",
        "text_source",
        "method"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceMethod": {
      "description": "Method used to extract or derive the field.",
      "enum": [
        "embedded",
        "ocr_llm",
        "rules",
        "derived",
        "human"
      ],
      "title": "EvidenceMethod",
      "type": "string"
    },
    "FieldStatus": {
      "description": "Field status indicating extraction and support disposition per ADR-010 \u00a73.",
      "enum": [
        "present",
        "missing",
        "ambiguous",
        "derived",
        "unsupported"
      ],
      "title": "FieldStatus",
      "type": "string"
    },
    "Field_DateValue_": {
      "properties": {
        "evidence": {
          "description": "One or more evidence records linking this field to source blocks.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "normalizer_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version string of the deterministic normalizer that computed value.",
          "title": "Normalizer Version"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Raw text snippet extracted from source document prior to normalization.",
          "title": "Raw"
        },
        "status": {
          "$ref": "#/$defs/FieldStatus",
          "default": "present",
          "description": "Lifecycle status: present, missing, ambiguous, derived, or unsupported."
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized typed value, or None if missing or unparseable."
        }
      },
      "title": "Field[DateValue]",
      "type": "object"
    },
    "Field_Money_": {
      "properties": {
        "evidence": {
          "description": "One or more evidence records linking this field to source blocks.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "normalizer_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version string of the deterministic normalizer that computed value.",
          "title": "Normalizer Version"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Raw text snippet extracted from source document prior to normalization.",
          "title": "Raw"
        },
        "status": {
          "$ref": "#/$defs/FieldStatus",
          "default": "present",
          "description": "Lifecycle status: present, missing, ambiguous, derived, or unsupported."
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized typed value, or None if missing or unparseable."
        }
      },
      "title": "Field[Money]",
      "type": "object"
    },
    "Field_Quantity_": {
      "properties": {
        "evidence": {
          "description": "One or more evidence records linking this field to source blocks.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "normalizer_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version string of the deterministic normalizer that computed value.",
          "title": "Normalizer Version"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Raw text snippet extracted from source document prior to normalization.",
          "title": "Raw"
        },
        "status": {
          "$ref": "#/$defs/FieldStatus",
          "default": "present",
          "description": "Lifecycle status: present, missing, ambiguous, derived, or unsupported."
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized typed value, or None if missing or unparseable."
        }
      },
      "title": "Field[Quantity]",
      "type": "object"
    },
    "Field_bool_": {
      "properties": {
        "evidence": {
          "description": "One or more evidence records linking this field to source blocks.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "normalizer_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version string of the deterministic normalizer that computed value.",
          "title": "Normalizer Version"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Raw text snippet extracted from source document prior to normalization.",
          "title": "Raw"
        },
        "status": {
          "$ref": "#/$defs/FieldStatus",
          "default": "present",
          "description": "Lifecycle status: present, missing, ambiguous, derived, or unsupported."
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized typed value, or None if missing or unparseable.",
          "title": "Value"
        }
      },
      "title": "Field[bool]",
      "type": "object"
    },
    "Field_str_": {
      "properties": {
        "evidence": {
          "description": "One or more evidence records linking this field to source blocks.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "normalizer_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version string of the deterministic normalizer that computed value.",
          "title": "Normalizer Version"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Raw text snippet extracted from source document prior to normalization.",
          "title": "Raw"
        },
        "status": {
          "$ref": "#/$defs/FieldStatus",
          "default": "present",
          "description": "Lifecycle status: present, missing, ambiguous, derived, or unsupported."
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized typed value, or None if missing or unparseable.",
          "title": "Value"
        }
      },
      "title": "Field[str]",
      "type": "object"
    },
    "InvoiceLineItem": {
      "description": "Line item extracted from a supplier invoice.",
      "properties": {
        "description": {
          "$ref": "#/$defs/Field_str_",
          "description": "Item or service description."
        },
        "discount": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_Money_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Line-level discount amount."
        },
        "evidence": {
          "description": "Evidence records citing source rows/cells for this line.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "hsn_sac": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Harmonized System of Nomenclature (HSN) or SAC code."
        },
        "item_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Supplier SKU or internal product code."
        },
        "line_number": {
          "description": "1-based ordinal line item position.",
          "minimum": 1,
          "title": "Line Number",
          "type": "integer"
        },
        "line_total": {
          "$ref": "#/$defs/Field_Money_",
          "description": "Total monetary amount for this line including taxes and discounts."
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_Quantity_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Billed physical quantity with units."
        },
        "tax_components": {
          "description": "Breakdown of taxes levied on this line.",
          "items": {
            "$ref": "#/$defs/TaxComponent"
          },
          "title": "Tax Components",
          "type": "array"
        },
        "taxable_amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_Money_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Base amount subject to taxation."
        },
        "unit_price": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_Money_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Price per individual unit."
        }
      },
      "required": [
        "line_number",
        "description",
        "line_total"
      ],
      "title": "InvoiceLineItem",
      "type": "object"
    },
    "InvoiceTotals": {
      "description": "Document-level monetary totals per ADR-010 \u00a75.",
      "properties": {
        "discount_total": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_Money_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Document-level trade discount."
        },
        "grand_total": {
          "$ref": "#/$defs/Field_Money_",
          "description": "Final payable invoice amount."
        },
        "other_charges_total": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_Money_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Freight, insurance, packaging or other ancillary charges."
        },
        "round_off": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_Money_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First-class round-off adjustment line."
        },
        "subtotal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_Money_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sum of item taxable amounts prior to taxes and charges."
        },
        "tax_total": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_Money_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total aggregate tax amount."
        }
      },
      "required": [
        "grand_total"
      ],
      "title": "InvoiceTotals",
      "type": "object"
    },
    "Money": {
      "description": "Financial amount with ISO 4217 currency.\n\nFloats are strictly rejected to guarantee decimal financial arithmetic (AGENTS.md \u00a76).",
      "properties": {
        "amount": {
          "description": "Decimal represented as a string to guarantee exact financial precision.",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "default": "INR",
          "description": "ISO 4217 currency code (e.g. INR, USD, EUR).",
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "title": "Money",
      "type": "object"
    },
    "Party": {
      "description": "Issuer or recipient party details.",
      "properties": {
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Registered or billing address string."
        },
        "name": {
          "$ref": "#/$defs/Field_str_",
          "description": "Legal business or trading name."
        },
        "tax_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tax identifier (e.g. GSTIN, PAN, VAT number)."
        }
      },
      "required": [
        "name"
      ],
      "title": "Party",
      "type": "object"
    },
    "PurchaseOrderPayload": {
      "description": "Stub schema for purchase orders.",
      "properties": {
        "buyer_name": {
          "$ref": "#/$defs/Field_str_"
        },
        "po_date": {
          "$ref": "#/$defs/Field_DateValue_"
        },
        "po_number": {
          "$ref": "#/$defs/Field_str_"
        },
        "total_amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_Money_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vendor_name": {
          "$ref": "#/$defs/Field_str_"
        }
      },
      "required": [
        "po_number",
        "po_date",
        "buyer_name",
        "vendor_name"
      ],
      "title": "PurchaseOrderPayload",
      "type": "object"
    },
    "Quantity": {
      "description": "Physical quantity with raw and canonical unit representations.\n\nSupports primary quantity and optional secondary quantity.",
      "properties": {
        "secondary_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secondary Unit"
        },
        "secondary_value": {
          "anyOf": [
            {
              "description": "Decimal represented as a string to guarantee exact financial precision.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secondary Value"
        },
        "unit_canonical": {
          "description": "Canonical unit identifier from registry.",
          "title": "Unit Canonical",
          "type": "string"
        },
        "unit_raw": {
          "description": "Unit string exactly as written on the document.",
          "title": "Unit Raw",
          "type": "string"
        },
        "value": {
          "description": "Decimal represented as a string to guarantee exact financial precision.",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit_raw",
        "unit_canonical"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "SupplierInvoicePayload": {
      "description": "Canonical payload for a supplier invoice per ADR-010 \u00a75.",
      "properties": {
        "currency": {
          "$ref": "#/$defs/Field_str_",
          "description": "Default document currency code (ISO 4217)."
        },
        "document_date": {
          "$ref": "#/$defs/Field_DateValue_",
          "description": "Stated invoice issuance date."
        },
        "document_number": {
          "$ref": "#/$defs/Field_str_",
          "description": "Invoice identifier/number."
        },
        "e_invoice_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Captured IRN / e-invoice acknowledgement reference."
        },
        "issuer": {
          "$ref": "#/$defs/Party",
          "description": "Selling or billing supplier party."
        },
        "line_items": {
          "description": "Collection of extracted invoice line items.",
          "items": {
            "$ref": "#/$defs/InvoiceLineItem"
          },
          "title": "Line Items",
          "type": "array"
        },
        "place_of_supply": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Captured place of supply (e.g. State code or name)."
        },
        "recipient": {
          "$ref": "#/$defs/Party",
          "description": "Buying or customer party."
        },
        "references": {
          "description": "Referenced purchase orders, delivery challans, or contract numbers.",
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "reverse_charge": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field_bool_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Captured reverse-charge indication without legal compliance claim."
        },
        "totals": {
          "$ref": "#/$defs/InvoiceTotals",
          "description": "Aggregate document totals."
        }
      },
      "required": [
        "issuer",
        "recipient",
        "document_number",
        "document_date",
        "totals"
      ],
      "title": "SupplierInvoicePayload",
      "type": "object"
    },
    "SupportStatus": {
      "description": "Status confirming value-support check results.",
      "enum": [
        "supported",
        "unsupported",
        "derived"
      ],
      "title": "SupportStatus",
      "type": "string"
    },
    "TaxComponent": {
      "description": "Itemized tax component (e.g. CGST, SGST, IGST).",
      "properties": {
        "amount": {
          "$ref": "#/$defs/Money",
          "description": "Calculated or stated tax monetary amount."
        },
        "rate": {
          "anyOf": [
            {
              "description": "Decimal represented as a string to guarantee exact financial precision.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Percentage tax rate (e.g. 9.00 for 9%), or None if unstated.",
          "title": "Rate"
        },
        "tax_type": {
          "description": "Tax category (e.g. CGST, SGST, IGST).",
          "title": "Tax Type",
          "type": "string"
        }
      },
      "required": [
        "tax_type",
        "amount"
      ],
      "title": "TaxComponent",
      "type": "object"
    },
    "TextSource": {
      "description": "Origin of extracted text.",
      "enum": [
        "embedded",
        "ocr"
      ],
      "title": "TextSource",
      "type": "string"
    },
    "UnknownDocumentPayload": {
      "description": "Payload for documents whose classification is unresolved or unsupported.",
      "properties": {
        "detected_keywords": {
          "description": "List of domain keywords detected during intake classification.",
          "items": {
            "type": "string"
          },
          "title": "Detected Keywords",
          "type": "array"
        },
        "unclassified_text": {
          "default": "",
          "description": "Captured unclassified raw text snippet for review.",
          "title": "Unclassified Text",
          "type": "string"
        }
      },
      "title": "UnknownDocumentPayload",
      "type": "object"
    },
    "ValidationIssue": {
      "description": "Structured validation issue conforming to AGENTS.md \u00a711.",
      "properties": {
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected value or invariant description.",
          "title": "Expected"
        },
        "field_paths": {
          "description": "JSON pointer or dotted field paths related to this issue.",
          "items": {
            "type": "string"
          },
          "title": "Field Paths",
          "type": "array"
        },
        "message": {
          "description": "Human-readable explanation.",
          "title": "Message",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Observed value or state that triggered the issue.",
          "title": "Observed"
        },
        "rule_key": {
          "description": "Unique deterministic validator rule key.",
          "title": "Rule Key",
          "type": "string"
        },
        "severity": {
          "description": "Severity level; error severity blocks approval.",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "rule_key",
        "severity",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    },
    "ValidationSummary": {
      "description": "Validation status and collected issues for a canonical document.",
      "properties": {
        "issues": {
          "description": "List of structured validation issues produced by deterministic validators.",
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "status": {
          "default": "pending",
          "description": "Aggregate validation status.",
          "enum": [
            "pending",
            "passed",
            "failed",
            "requires_review"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "ValidationSummary",
      "type": "object"
    }
  },
  "description": "Top-level immutable versioned envelope for all canonical business documents.",
  "properties": {
    "document_id": {
      "description": "UUID of the parent document intake record.",
      "title": "Document Id",
      "type": "string"
    },
    "document_type": {
      "$ref": "#/$defs/DocumentType",
      "description": "Closed document classification type."
    },
    "evidence": {
      "description": "Document-level and unassigned evidence references.",
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/SupplierInvoicePayload"
        },
        {
          "$ref": "#/$defs/CreditNotePayload"
        },
        {
          "$ref": "#/$defs/PurchaseOrderPayload"
        },
        {
          "$ref": "#/$defs/DeliveryChallanPayload"
        },
        {
          "$ref": "#/$defs/ElectricityBillPayload"
        },
        {
          "$ref": "#/$defs/UnknownDocumentPayload"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ],
      "description": "Typed domain payload corresponding to document_type.",
      "title": "Payload"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "SemVer schema version of this payload.",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "description": "UUID of the owning tenant.",
      "title": "Tenant Id",
      "type": "string"
    },
    "validation": {
      "$ref": "#/$defs/ValidationSummary",
      "description": "Deterministic validation results for this version."
    }
  },
  "required": [
    "document_id",
    "tenant_id",
    "document_type",
    "payload"
  ],
  "title": "CanonicalEnvelope",
  "type": "object"
}
